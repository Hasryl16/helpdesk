# Postgres from `docker compose up -d db` (published on port 5433).
# Docker Compose sets its own DATABASE_URL for the backend container.
DATABASE_URL=postgresql+psycopg://helpdesk:helpdesk@localhost:5433/helpdesk
# Make your own: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-me-with-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=uploads
